# John F. Kennedy International (JFK / KJFK)
# Real runway data: https://en.wikipedia.org/wiki/John_F._Kennedy_International_Airport
# Four runways — JFK's distinctive layout used aggressively in this config
# to exercise the multi-runway capability matching.
#   04L/22R — 3,682 m  (ICAO 4F, supports A380)
#   04R/22L — 2,560 m  (medium, narrow-body limited)
#   13L/31R — 3,048 m  (medium-heavy capable)
#   13R/31L — 4,423 m  (longest — true heavy lift)

ATC_RUNWAYS=04L:3682:heavy,04R:2560:medium,13L:3048:heavy,13R:4423:heavy

ATC_GATE_COUNT=12
ATC_GROUND_CREW_COUNT=14

# JFK's mix of wide-body international traffic + domestic narrow-body
# means slightly tighter takeoff separation but longer mixed-ops gap.
ATC_SEPARATION_BUFFER_TAKEOFF_S=75
ATC_SEPARATION_BUFFER_LANDING_S=120
ATC_SEPARATION_BUFFER_MIXED_S=180

ATC_GATE_TURNAROUND_TIME_S=2400
ATC_DEPENDENCY_BUFFER_S=1200

ATC_OP_DURATION_ARRIVAL_S=780
ATC_OP_DURATION_DEPARTURE_S=660

ATC_SCHEDULING_HORIZON_HOURS=14
