# Almaty International (ALA / UAAA)
# Real runway data: https://en.wikipedia.org/wiki/Almaty_International_Airport
# A regional hub with constrained runway capability — useful for testing
# the Scenario-2-style "no suitable runway" path against realistic data.
#   05L/23R — 3,400 m  (medium-heavy)
#   05R/23L — 4,500 m  (heavy)
# Note: 23L/05R closed in some periods of 2020-2023, so we include it
# but the shorter parallel is the primary.

ATC_RUNWAYS=05L:3400:medium,05R:4500:heavy

ATC_GATE_COUNT=6
ATC_GROUND_CREW_COUNT=5

ATC_SEPARATION_BUFFER_TAKEOFF_S=60
ATC_SEPARATION_BUFFER_LANDING_S=90
ATC_SEPARATION_BUFFER_MIXED_S=120

ATC_GATE_TURNAROUND_TIME_S=1800
ATC_DEPENDENCY_BUFFER_S=600

ATC_OP_DURATION_ARRIVAL_S=600
ATC_OP_DURATION_DEPARTURE_S=540

ATC_SCHEDULING_HORIZON_HOURS=10
