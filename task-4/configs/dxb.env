# Dubai International (DXB / OMDB)
# Real runway data: https://en.wikipedia.org/wiki/Dubai_International_Airport
# Two long parallel runways both designed for unrestricted A380 ops.
#   12L/30R — 4,000 m
#   12R/30L — 4,447 m

ATC_RUNWAYS=12L:4000:heavy,12R:4447:heavy

# Massive 184-gate operation; we sample a busy morning bank.
ATC_GATE_COUNT=10
ATC_GROUND_CREW_COUNT=12

# DXB's wake-turbulence rules between heavies are strict.
ATC_SEPARATION_BUFFER_TAKEOFF_S=120
ATC_SEPARATION_BUFFER_LANDING_S=120
ATC_SEPARATION_BUFFER_MIXED_S=180

# DXB ground turnarounds for the wide-body fleet are longer.
ATC_GATE_TURNAROUND_TIME_S=3000

# Connecting passenger MCT at DXB Terminal 3: 60 min.
ATC_DEPENDENCY_BUFFER_S=900

ATC_OP_DURATION_ARRIVAL_S=900
ATC_OP_DURATION_DEPARTURE_S=720

ATC_SCHEDULING_HORIZON_HOURS=12
