# London Heathrow (LHR / EGLL)
# Real runway data: https://en.wikipedia.org/wiki/Heathrow_Airport (as of 2024)
# Two parallel runways, both rated for ICAO category F (A380-capable).
#   09L/27R — 3,902 m
#   09R/27L — 3,660 m
# Both can handle anything, but we model the longer one as "heavy"
# capacity and the shorter as "medium" so the scheduler can demonstrate
# capability-based routing.

ATC_RUNWAYS=27L:3902:heavy,27R:3660:medium

# Heathrow has 115 stands across Terminals 2/3/4/5. For a one-process
# simulator we cap gates at a manageable number — 8 is a fair "morning
# busy hour" capacity.
ATC_GATE_COUNT=8
ATC_GROUND_CREW_COUNT=10

# ICAO wake-turbulence separation (medium-medium): ~90s
# Heavy-heavy departures get longer because of wake vortices.
ATC_SEPARATION_BUFFER_TAKEOFF_S=90
ATC_SEPARATION_BUFFER_LANDING_S=120
ATC_SEPARATION_BUFFER_MIXED_S=150

# Real-world LHR average turnaround for narrow-body: 35-45 min.
ATC_GATE_TURNAROUND_TIME_S=2100

# Connecting-flight minimum connect time MCT at LHR: ~60 min international.
ATC_DEPENDENCY_BUFFER_S=900

# Operation durations include taxi + runway time.
ATC_OP_DURATION_ARRIVAL_S=720
ATC_OP_DURATION_DEPARTURE_S=600

# 12-hour rolling schedule horizon — a typical morning-to-evening bank.
ATC_SCHEDULING_HORIZON_HOURS=12
