# AtcMcpServer — environment configuration
#
# Copy to .env and adjust. The server validates EVERY variable at startup
# and exits with EX_CONFIG (78) on any error, naming the offending variable
# in the error message (per R2b).

# === Runways ============================================================
# Comma-separated list, each entry "id:length_meters:category".
# id        — short identifier shown in the schedule output (e.g. "R1", "27L")
# length_m  — runway length in meters; flights with min_runway_length_m
#             above this number cannot be placed on it
# category  — free-form label matched case-insensitively against
#             flight.required_runway_category ("heavy", "medium", "short", ...)
ATC_RUNWAYS=R1:3500:medium,R2:4000:heavy

# (Optional) declared count, cross-checked against ATC_RUNWAYS length at startup.
# ATC_RUNWAY_COUNT=2

# === Capacity ===========================================================
ATC_GATE_COUNT=4
ATC_GROUND_CREW_COUNT=4

# === Runway separation buffers (seconds) ================================
# Minimum gap on the SAME runway between consecutive operations.
# Three distinct values per the brief; "mixed" applies when consecutive
# ops on the same runway are of different operation types.
ATC_SEPARATION_BUFFER_TAKEOFF_S=60
ATC_SEPARATION_BUFFER_LANDING_S=90
ATC_SEPARATION_BUFFER_MIXED_S=120

# === Gate turnaround (seconds) ==========================================
# After a flight releases a gate, the gate is unavailable for this long
# before another flight can use it.
ATC_GATE_TURNAROUND_TIME_S=600

# === Dependency buffer (seconds) ========================================
# Minimum gap between a dependency's end time and its dependant's start.
# Scenario 3 in the brief: outbound waits for inbound + this buffer.
ATC_DEPENDENCY_BUFFER_S=300

# === Operation durations (seconds) =====================================
# How long a single arrival / departure occupies its runway + gate.
ATC_OP_DURATION_ARRIVAL_S=600
ATC_OP_DURATION_DEPARTURE_S=480

# === Scheduling horizon (hours) ========================================
# Flights that can't fit a slot within this horizon are reported
# Unscheduled with NO_RESOURCE_SLOT_IN_HORIZON reason.
ATC_SCHEDULING_HORIZON_HOURS=12
